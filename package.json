{
  "name": "milankovic-visualization",
  "version": "0.1.0",
  "description": "A guided, interactive explanation of the Milankovic cycles",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "textures:build": "node scripts/build-space-textures.mjs",
    "graphics:profile": "node scripts/profile-space.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "climate",
    "milankovitch",
    "orbital",
    "model"
  ],
  "author": "Filip van Harreveld",
  "license": "MIT",
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@vercel/analytics": "1.6.1",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.34.5",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "basisu": "1.16.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.10",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
